# ==============================================================================
# SALONPRO SAAS - CONFIGURACIÓN DE ENTORNO (.env.example)
# NOTA DE SEGURIDAD: Todos los valores son FICTICIOS / PLANTILLAS de referencia.
# ==============================================================================

# Entorno de Ejecución
NODE_ENV=development
PORT=5005
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de Datos (OBLIGATORIAS: el servidor falla al arrancar si falta alguna)
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dummy_db_user
DB_PASS=dummy_db_password_change_me
DB_NAME=dummy_salon_saas_db

# Seguridad Criptográfica JWT (OBLIGATORIO: Mínimo 32 caracteres / 256 bits)
JWT_SECRET=dummy_min_32_characters_cryptographically_secure_random_key_here

# Secreto para Procesos Automatizados Cron (OBLIGATORIO: Mínimo 16 caracteres)
CRON_SECRET=dummy_cron_secret_min_16_chars_here

# Habilitación de Endpoints de Prueba (true solo en desarrollo aislado, NUNCA en producción)
ENABLE_TEST_ENDPOINTS=false

# Pasarela de Pagos CardNet (Valores Ficticios de Entorno Sandbox)
CARDNET_BASE_URL=https://labservicios.cardnet.com.do/servicios/tokens/v1
CARDNET_PUBLIC_KEY=dummy_cardnet_public_key
CARDNET_PRIVATE_KEY=dummy_cardnet_private_key
CARDNET_MERCHANT_NUMBER=000000000
CARDNET_TERMINAL_ID=00000000
CARDNET_ENV=STAGING
CARDNET_TIMEOUT=30000

# Correo y Notificaciones SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=dummy_smtp_password
SMTP_FROM=no-reply@example.com

# Facturación Electrónica DGII
DGII_ENV=Certificacion
DGII_CERT_PATH=certs/dummy_cert.p12
DGII_CERT_PASSWORD=dummy_cert_password
