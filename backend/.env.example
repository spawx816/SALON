CARDNET_BASE_URL=https://servicios.cardnet.com.do/servicios/tokens/v1
CARDNET_PUBLIC_KEY=your_cardnet_public_key
CARDNET_PRIVATE_KEY=your_cardnet_private_key
CARDNET_MERCHANT_NUMBER=your_merchant_number
CARDNET_TERMINAL_ID=your_terminal_id
CARDNET_ENV=SANDBOX

PORT=5005
JWT_SECRET=your_32_byte_hex_jwt_secret_here_do_not_commit
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name
FRONTEND_URL=http://localhost:5173
SMTP_FROM=hola@example.com

COMPREFACE_API_KEY=your_compreface_api_key
COMPREFACE_ENDPOINT=http://localhost:8000
CARDNET_TIMEOUT=30000

BACKUP_ENCRYPTION_KEY=your_32_byte_hex_backup_encryption_key
BACKUP_HMAC_KEY=your_32_byte_hex_backup_hmac_key
SUPERADMIN_BOOTSTRAP_SECRET=your_superadmin_bootstrap_secret

# Test Environment Isolation
ALLOW_INTEGRATION_TESTS=false
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_USER=your_test_user
TEST_DB_PASSWORD=your_test_password
TEST_DB_NAME=salon_saas_disposable
